{
  "name": "alexa-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP para controlar e configurar a Alexa pelo Claude",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "alexa-mcp": "dist/index.js",
    "alexa-mcp-auth": "dist/auth-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "auth": "npm run build && node dist/auth-cli.js",
    "start": "npm run build && node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "alexa-remote2": "^8.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
