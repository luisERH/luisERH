# --- obrigatórias ---------------------------------------------------------
# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# URL pública HTTPS onde este servidor responde, sem barra final.
# Em desenvolvimento: cloudflared tunnel --url http://127.0.0.1:8080
ALEXA_MCP_PUBLIC_URL=https://seu-dominio.trycloudflare.com

# Senha da tela de consentimento (mínimo 12 caracteres). É ela que autoriza
# o Alexa+ a usar este servidor — use algo longo e único.
ALEXA_MCP_LOGIN_PASSWORD=troque-esta-senha-agora

# --- opcionais ------------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024
ALEXA_MCP_LANGUAGE=pt-BR
ALEXA_MCP_MAX_SPOKEN_CHARS=600
ALEXA_MCP_HISTORY_TURNS=12
ALEXA_MCP_DB_PATH=data/alexa_mcp.sqlite3
ALEXA_MCP_HOST=127.0.0.1
ALEXA_MCP_PORT=8080
ALEXA_MCP_ACCESS_TOKEN_TTL=3600
ALEXA_MCP_REFRESH_TOKEN_TTL=2592000
# Hosts aceitos em redirect_uri (separados por vírgula). O padrão cobre os
# domínios da Amazon e localhost.
# ALEXA_MCP_ALLOWED_REDIRECT_HOSTS=amazon.com,amazonalexa.com,alexa.com,localhost
# Cliente OAuth fixo, caso o console não use registro dinâmico:
# ALEXA_MCP_STATIC_CLIENT_ID=
# ALEXA_MCP_STATIC_CLIENT_SECRET=
# ALEXA_MCP_STATIC_REDIRECT_URIS=https://exemplo.amazon.com/callback
